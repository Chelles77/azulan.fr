# DATABASE (MongoDB Atlas - obtenir une connection string gratuite)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/azulan?retryWrites=true&w=majority

# JWT Secret (change this to a strong random string!)
JWT_SECRET=your_super_secret_jwt_key_minimum_32_chars_long_change_me!!!

# Stripe (obtenir sur https://stripe.com)
STRIPE_SECRET_KEY=sk_test_your_stripe_test_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_test_key_here

# Server config
PORT=5000
NODE_ENV=production

# CORS (frontend URL)
FRONTEND_URL=https://azulan.fr

# Email notifications (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password